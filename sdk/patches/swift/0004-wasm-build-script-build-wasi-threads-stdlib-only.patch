+++ b/utils/swift_build_support/swift_build_support/products/wasistdlib.py
@@ -35,10 +35,11 @@ class WASIStdlib(cmake_product.CMakeProduct):
         return False
 
     def should_build(self, host_target):
-        return self.args.build_wasistdlib
+        return self.args.build_wasistdlib and \
